# SKUAST-K Certificate System — Environment Variables
# Copy this file to .env and fill in your actual values

# Supabase Configuration
# Get these values from your Supabase dashboard: https://supabase.com/dashboard
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# Admin Credentials (Change these in Supabase Auth after setup)
ADMIN_EMAIL=admin@skuastkashmir.ac.in
ADMIN_PASSWORD=ChangeMe_123

# Rate Limiting (optional)
RATE_LIMIT_WINDOW=15m
RATE_LIMIT_MAX_REQUESTS=100

# Security Headers (optional)
ENFORCE_HTTPS=true
